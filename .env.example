# n8n Webhook Configuration
# URL של ה-Webhook ב-n8n לקבלת קבצי אודיו
N8N_WEBHOOK_URL=https://roymichaeli.app.n8n.cloud/webhook/transcribe-ingest

# Server Port
# הפורט שבו הדשבורד ירוץ
PORT=3000

# Environment
# development או production
NODE_ENV=development

# Supabase (for Vercel persistent storage)
# Auto-configured when connecting Supabase via Vercel Dashboard → Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
