# n8n Webhook Configuration
# URL של ה-Webhook ב-n8n לקבלת קבצי אודיו
N8N_WEBHOOK_URL=https://roymichaeli.app.n8n.cloud/webhook/transcribe-ingest

# Server Port
# הפורט שבו הדשבורד ירוץ
PORT=3000

# Environment
# development או production
NODE_ENV=development

# Upstash Redis (for Vercel persistent storage)
# Get these from https://console.upstash.com or Vercel Marketplace
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
